{
  "name": "dsh-https-fix",
  "version": "0.1.5-rc.1",
  "description": "DeepSeek Harness 插件:内置 HTTPS 反向代理与统一配置管理。在 设置→插件配置→Https Fix 中配置关闭 http 外网访问、http/https 端口、域名、TLS 证书密钥路径,并提供校验与保存。Built-in HTTPS reverse proxy for dsh Web GUI with in-app configuration (block external http, http/https ports, domain, TLS cert/key) plus validate & save actions.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Https Fix",
    "summary": "为 dsh Web GUI 提供内置 HTTPS 反向代理与统一配置(关闭 http 外网访问、http/https 端口、域名、TLS 证书/密钥路径、校验与保存)。",
    "categories": ["网络", "Web UI", "部署"],
    "surfaces": ["host", "web"],
    "capabilities": { "provides": ["settings:https-fix", "service:https-fix"] },
    "compatibility": { "dsh": "0.1.5-rc.1", "node": ">=20" },
    "permissions": { "network": ["127.0.0.1"], "files": ["$DSH_HOME/cordis.patch.yml", "TLS certificate/key paths"] }
  },
  "files": ["lib", "cordis.patch.yml"],
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "license": "MIT",
  "author": { "name": "MingYU-kalo" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MingYU-kalo/dsh-https-fix.git"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "https", "reverse-proxy", "tls", "web"]
}
